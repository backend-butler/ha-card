{
  "name": "butler-quick-card",
  "version": "1.0.0",
  "description": "Dashboard launcher card for the Backend Butler Home Assistant app",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild card/butler-quick-card.ts --bundle --format=esm --minify --target=es2022 --outfile=dist/butler-quick-card.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "lit": "3.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
